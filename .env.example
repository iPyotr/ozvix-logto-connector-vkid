# =============================================================================
# ozvix-logto-connector-vkid - environment template (PLACEHOLDERS ONLY)
# =============================================================================
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`:
# `.env` is git-ignored, this file is the only template that belongs in git.
#
#   Copy-Item .env.example .env    # PowerShell
#   cp .env.example .env           # bash / WSL2
#
# The variable names below are aligned with compose.test.yaml and with the
# connector's configuration (see docs/LOCAL-TESTING.md).
# =============================================================================

# -----------------------------------------------------------------------------
# VK ID application credentials (https://id.vk.ru/about/business/go/)
# -----------------------------------------------------------------------------
# `client_id` = "ID приложения". Required.
VKID_CLIENT_ID=<your-vk-id-app-id>
# "Сервисный ключ доступа" / service_token. Optional - required only for
# VK apps marked as confidential; sent as the `service_token` POST parameter on
# the code exchange and on refresh. VK ID does NOT use an OAuth `client_secret`.
VKID_SERVICE_TOKEN=
# Space-separated scopes. Default: vkid.personal_info. `email`/`phone` must also
# be enabled for the app in the VK ID cabinet; `phone` needs a verified business
# profile.
VKID_SCOPE=vkid.personal_info
# Must be registered VERBATIM as the app's trusted redirect URL in the VK ID
# cabinet, and its host must equal the app's base domain.
# Local VK ID testing only allows http://localhost:80 or https://localhost:443.
VKID_REDIRECT_URI=https://your-logto.example.com/callback/vkid

# -----------------------------------------------------------------------------
# Local integration-test stack (compose.test.yaml / .env.test.example)
# Safe placeholders / local-only defaults; nothing here is a real secret.
# -----------------------------------------------------------------------------
# `mock` = mock VK ID provider stack (default), `real` = real credentials stack
# (no mock provider). Compose reads COMPOSE_PROFILES from `.env`.
COMPOSE_PROFILES=mock

POSTGRES_USER=logto
POSTGRES_PASSWORD=<local-test-password>
POSTGRES_DB=logto

LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
MOCK_VKID_HOST_PORT=8090

LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

MOCK_VKID_CLIENT_IDS=mock-vkid-client-id
MOCK_VKID_REDIRECT_URIS=http://localhost:3001/callback,http://localhost:3001/callback/vkid,http://localhost:3001/callback/*
MOCK_VKID_SLOW_MS=30000
MOCK_VKID_TOKEN_MODE=
MOCK_VKID_USER_MODE=
