# =============================================================================
# Local integration-test environment for `docker compose -f compose.test.yaml`
# =============================================================================
# Copy this file to `.env` in the SAME directory (repo root) - Docker Compose
# reads `.env` automatically for variable interpolation:
#
#   Copy-Item .env.test.example .env      # PowerShell
#   cp .env.test.example .env             # bash / WSL2
#
# NOTHING in this file is a real secret. It only drives the disposable local
# test stack (a throw-away Postgres, a local Logto, and the mock VK ID server).
# Never put real VK ID credentials here; use .env.example for those.
# =============================================================================

# Turns the default `mock` profile on, so plain
# `docker compose -f compose.test.yaml up -d --build` starts the mock VK ID
# provider too. Switch to `real` to run the real-credentials stack instead.
COMPOSE_PROFILES=mock

# --- Postgres (disposable test DB only; not published to the host) -----------
POSTGRES_USER=logto
POSTGRES_PASSWORD=logto_local_test_password
POSTGRES_DB=logto

# --- Host ports ---------------------------------------------------------------
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002
MOCK_VKID_HOST_PORT=8090

# --- Logto endpoints (must match what the browser uses) -----------------------
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# --- mock VK ID provider (only used by the `mock` profile) --------------------
# client_id the mock accepts; the connector is configured with this value.
MOCK_VKID_CLIENT_IDS=mock-vkid-client-id
# Exact redirect_uri allowlist. Logto builds the social callback path from the
# connector's database id (http://localhost:3001/callback/<connector-id>), so a
# prefix wildcard is allowlisted: scheme + host + path prefix stay pinned.
MOCK_VKID_REDIRECT_URIS=http://localhost:3001/callback,http://localhost:3001/callback/vkid,http://localhost:3001/callback/*
# Delay used by the `?mock_slow=1` failure mode (ms).
MOCK_VKID_SLOW_MS=30000
# Optional global failure modes (leave empty for the happy path):
#   http_400 | http_401 | http_500 | invalid_json | empty |
#   missing_refresh_token | missing_id_token | missing_user_id | missing_scope ...
MOCK_VKID_TOKEN_MODE=
#   missing_email | missing_avatar | empty_strings | null_fields | http_500 | http_401 | invalid_json
MOCK_VKID_USER_MODE=

# -----------------------------------------------------------------------------
# Real VK ID credentials - placeholders only, NEVER commit real values.
# These are used ONLY with COMPOSE_PROFILES=real (and the connector wiring).
# -----------------------------------------------------------------------------
# VK ID application id (numeric), from https://id.vk.ru/about/business/go/
VKID_CLIENT_ID=
# Optional: only for "confidential" VK apps, sent as the `service_token` param.
VKID_SERVICE_TOKEN=
# Space-separated scopes. VK's default is vkid.personal_info.
VKID_SCOPE=vkid.personal_info
# Must be registered verbatim in the VK ID cabinet as the trusted redirect URL.
VKID_REDIRECT_URI=http://localhost:3001/callback/vkid
